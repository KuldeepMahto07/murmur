# Hugging Face token for pyannote speaker diarization (optional).
# 1) Create a read token at https://huggingface.co/settings/tokens
# 2) Accept the terms at https://huggingface.co/pyannote/speaker-diarization-3.1
#    and https://huggingface.co/pyannote/segmentation-3.0
# Without it Murmur uses its built-in ECAPA speaker clustering.
HF_TOKEN=

# auto | cpu
MURMUR_DEVICE=auto
# Per-file upload cap in MB (0 = none)
MURMUR_MAX_UPLOAD_MB=5120
# Comma-separated origins allowed to call this server from a separately hosted UI,
# e.g. https://murmur-xyz.vercel.app (leave empty for local use)
MURMUR_CORS_ORIGINS=
